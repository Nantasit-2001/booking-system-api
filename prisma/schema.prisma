generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model blocked_room {
  id         Int       @id @default(autoincrement())
  room_id    Int
  check_in   DateTime  @db.Date
  check_out  DateTime  @db.Date
  created_at DateTime? @default(now()) @db.Timestamp(6)
  clerk_id   String?   @db.VarChar
  rooms      rooms     @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_blocked_room_room")
}

model reservation {
  id                 Int       @id @default(autoincrement())
  room_id            Int
  status_reservation String?   @default("pending") @db.VarChar(20)
  check_in           DateTime  @db.Date
  check_out          DateTime  @db.Date
  total_price        Decimal?  @db.Decimal(10, 2)
  paid_amount        Decimal?  @db.Decimal(10, 2)
  note               String?
  phone_number       String?   @db.VarChar(20)
  clerk_id           String?   @db.VarChar(255)
  payment            payment[]
  rooms              rooms     @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reservation_room")
  users              users?    @relation(fields: [clerk_id], references: [clerkId], onDelete: NoAction, onUpdate: NoAction, map: "fk_reservation_user_clerkid")
}

model rooms {
  id           Int            @id @default(autoincrement())
  room_name    String         @db.VarChar(100)
  room_type    String?        @db.VarChar(50)
  description  String?
  price        Decimal?       @db.Decimal(10, 2)
  url_picture  String[]
  room_status  String?        @default("available") @db.VarChar(20)
  max_guests   Int?
  blocked_room blocked_room[]
  reservation  reservation[]
}

model users {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  email       String        @unique @db.VarChar(100)
  clerkId     String        @unique @db.VarChar(255)
  createdAt   DateTime?     @default(now()) @db.Timestamptz(6)
  role        String?       @db.VarChar(50)
  reservation reservation[]
}

model payment {
  id             Int         @id @default(autoincrement())
  reservation_id Int
  charge_id      String      @unique
  amount         Decimal     @db.Decimal(10, 2)
  status         String?     @default("pending") @db.VarChar(20)
  paid_at        DateTime?   @db.Timestamp(6)
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  reservation    reservation @relation(fields: [reservation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_reservation")
}

model documents {
  id        Int                    @id @default(autoincrement())
  text      String
  embedding Unsupported("vector")?
}
